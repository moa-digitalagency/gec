# =================================================================
# GEC — Variables d'Environnement
# Copiez ce fichier vers .env et remplissez vos valeurs
# NE JAMAIS commiter .env dans git
# =================================================================

# Environnement
FLASK_ENV=development

# Base de données
# Production : PostgreSQL obligatoire
DATABASE_URL=postgresql://user:password@host:5432/gecmines

# Sécurité Flask
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters

# =================================================================
# Clés de chiffrement (générer UNE SEULE FOIS, conserver précieusement)
# python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# =================================================================
GEC_MASTER_KEY=
GEC_PASSWORD_SALT=

# Mot de passe super admin par défaut
ADMIN_PASSWORD=YourSecurePassword123!

# =================================================================
# Exposition (valeurs par défaut adaptées à nginx / IIS en HTTPS)
# =================================================================
# GEC_HTTPS=0            # site servi en HTTP simple (intranet sans certificat)
# GEC_DERRIERE_PROXY=0   # GEC exposé directement, sans nginx ni IIS devant

# =================================================================
# Email via Resend (https://resend.com)
# Configurez également l'adresse expéditrice dans Paramètres → Email
# =================================================================
# La clé API se configure dans l'interface : Paramètres → Email → Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx   # optionnel ici, géré en UI

# =================================================================
# Cache Redis (optionnel — fallback mémoire si absent)
# =================================================================
# REDIS_URL=redis://localhost:6379/0
