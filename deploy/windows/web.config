<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS en proxy inverse devant Waitress (GEC).

  Prérequis : modules Application Request Routing 3.0 et URL Rewrite 2.1,
  et « Enable proxy » coché dans ARR (IIS Manager > serveur > Application
  Request Routing Cache > Server Proxy Settings).

  À déposer à la racine du site IIS. Le site n'a pas besoin de contenir de
  fichiers : tout est relayé vers l'application.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="GEC - proxy vers Waitress" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5004/{R:1}" />
          <serverVariables>
            <!-- Sans ces en-têtes, le journal d'audit enregistre 127.0.0.1
                 au lieu de l'adresse réelle des utilisateurs.
                 X-Real-IP est ÉCRASÉ par l'adresse vue par IIS : GEC lui fait
                 confiance, et un client qui l'enverrait lui-même pourrait sinon
                 changer d'adresse à chaque essai et contourner la limitation des
                 tentatives de connexion.
                 Ces variables doivent être autorisées au niveau du serveur
                 (installer-gec.ps1 -Mode IIS le fait), sinon IIS répond 500.50. -->
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Aligné sur max_upload_mb (Paramètres > Sécurité) : 100 Mo.
             IIS refuse par défaut au-delà de 30 Mo, avant même d'atteindre
             l'application. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
